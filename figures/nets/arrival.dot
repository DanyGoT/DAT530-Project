// Arrival module, made by analysis/net_dot.m from arrival_pdf.m.
digraph Arrival {
  rankdir=LR; nodesep=0.3; ranksep=0.8; forcelabels=true;
  label="Arrival"; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10, label=""];
  edge [arrowsize=0.6, penwidth=0.8];
  "tABypass" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tABypass"];
  "tACBypass" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tACBypass"];
  "tACHall" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tACHall"];
  "tALong" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tALong"];
  "tAShort" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tAShort"];
  { rank=max; "tALong"; "tAShort"; "tABypass"; "tACHall"; "tACBypass";  }
  "pAClock" [shape=circle, fixedsize=true, width=0.36, xlabel="pAClock", label="1"];
  "pAClock" -> "tALong";
  "tALong" -> "pAClock";
  "pAClock" -> "tAShort";
  "tAShort" -> "pAClock";
  "pAClock" -> "tABypass";
  "tABypass" -> "pAClock";
  "pAClock" -> "tACHall";
  "tACHall" -> "pAClock";
  "pAClock" -> "tACBypass";
  "tACBypass" -> "pAClock";
}
