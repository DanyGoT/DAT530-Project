// Departure module, made by analysis/net_dot.m from departure_pdf.m.
digraph Departure {
  rankdir=LR; nodesep=0.3; ranksep=0.8; forcelabels=true;
  label="Departure"; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10, label=""];
  edge [arrowsize=0.6, penwidth=0.8];
  "tDShip" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tDShip"];
  "tDTicket" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tDTicket"];
  { rank=min; "tDShip";  }
  { rank=max; "tDTicket";  }
  "pDClock" [shape=circle, fixedsize=true, width=0.36, xlabel="pDClock", label="1"];
  "pDShipped" [shape=circle, fixedsize=true, width=0.36, xlabel="pDShipped", label=""];
  "pDClock" -> "tDTicket";
  "tDTicket" -> "pDClock";
  "tDShip" -> "pDShipped";
}
