// Inspection module, made by analysis/net_dot.m from inspection_pdf.m.
digraph Inspection {
  rankdir=LR; nodesep=0.3; ranksep=0.8; forcelabels=true;
  label="Inspection"; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10, label=""];
  edge [arrowsize=0.6, penwidth=0.8];
  "tICheck_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tICheck_1...2"];
  "tIClean_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIClean_1...12"];
  "tIFinish_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIFinish_1...12"];
  "tIHb" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIHb"];
  "tIIn" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIIn"];
  "tIInRepair" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIInRepair"];
  "tIInspect_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIInspect_1...7"];
  "tIMach" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIMach"];
  "tIOk" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIOk"];
  "tIRoom" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIRoom"];
  "tIScrap" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tIScrap"];
  "tIStart" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIStart"];
  "tIUTSkip" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIUTSkip"];
  "tIUT_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tIUT_1"];
  { rank=min; "tIIn"; "tIInRepair";  }
  { rank=max; "tIOk"; "tIMach"; "tIHb"; "tIScrap"; "tIRoom";  }
  "pIClean" [shape=circle, fixedsize=true, width=0.36, xlabel="pIClean", label=""];
  "pIInspect" [shape=circle, fixedsize=true, width=0.36, xlabel="pIInspect", label=""];
  "pICheck" [shape=circle, fixedsize=true, width=0.36, xlabel="pICheck", label=""];
  "pIUT" [shape=circle, fixedsize=true, width=0.36, xlabel="pIUT", label=""];
  "pIFinish" [shape=circle, fixedsize=true, width=0.36, xlabel="pIFinish", label=""];
  "pIDone" [shape=circle, fixedsize=true, width=0.36, xlabel="pIDone", label=""];
  "pISpace" [shape=circle, fixedsize=true, width=0.36, xlabel="pISpace", label="70"];
  "pIStart" [shape=circle, fixedsize=true, width=0.36, xlabel="pIStart", label="15"];
  "pIRoom" [shape=circle, fixedsize=true, width=0.36, xlabel="pIRoom", label=""];
  "pIStart" -> "tIStart";
  "pISpace" -> "tIStart";
  "tIStart" -> "pIClean";
  "tIIn" -> "pIRoom";
  "pIRoom" -> "tIRoom";
  "pISpace" -> "tIIn";
  "tIIn" -> "pIClean";
  "pISpace" -> "tIInRepair";
  "tIInRepair" -> "pIClean";
  "pIClean" -> "tIClean_1";
  "tIClean_1" -> "pIInspect";
  "pIInspect" -> "tIInspect_1";
  "tIInspect_1" -> "pICheck";
  "pICheck" -> "tICheck_1";
  "tICheck_1" -> "pIUT";
  "pIUT" -> "tIUT_1";
  "tIUT_1" -> "pIFinish";
  "pIUT" -> "tIUTSkip";
  "tIUTSkip" -> "pIFinish";
  "pIFinish" -> "tIFinish_1";
  "tIFinish_1" -> "pIDone";
  "pIDone" -> "tIOk";
  "tIOk" -> "pISpace";
  "pIDone" -> "tIMach";
  "tIMach" -> "pISpace";
  "pIDone" -> "tIHb";
  "tIHb" -> "pISpace";
  "pIDone" -> "tIScrap";
  "tIScrap" -> "pISpace";
}
