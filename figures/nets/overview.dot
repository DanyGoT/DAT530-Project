// The whole net (model_pdfs.m), made by analysis/net_dot.m from the PDFs:
// each module as a box, each connector place (imc/) as a circle.
digraph Overview {
  rankdir=LR; nodesep=0.35; ranksep=0.55; forcelabels=true;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [arrowsize=0.6, penwidth=0.8];
  "Arrival" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  "Yard" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  "Washing" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  "Inspection" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  "Repair" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  "Departure" [shape=box, style="rounded,filled", fillcolor="#dbe7f5", color="#1f5fa8", fontsize=12, width=1.2, height=0.5];
  { rank=same; "Repair"; "Departure"; }
  "pAYLong" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pAYLong", fontsize=8];
  "Arrival" -> "pAYLong";
  "pAYLong" -> "Yard";
  "pAYShort" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pAYShort", fontsize=8];
  "Arrival" -> "pAYShort";
  "pAYShort" -> "Yard";
  "pAYBypass" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pAYBypass", fontsize=8];
  "Arrival" -> "pAYBypass";
  "pAYBypass" -> "Yard";
  "pAYCHall" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pAYCHall", fontsize=8];
  "Arrival" -> "pAYCHall";
  "pAYCHall" -> "Yard";
  "pAYCBypass" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pAYCBypass", fontsize=8];
  "Arrival" -> "pAYCBypass";
  "pAYCBypass" -> "Yard";
  "pYW" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pYW", fontsize=8];
  "Yard" -> "pYW";
  "pYW" -> "Washing";
  "pWI" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pWI", fontsize=8];
  "Washing" -> "pWI";
  "pWI" -> "Inspection";
  "pIYOk" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pIYOk", fontsize=8];
  "Inspection" -> "pIYOk" [constraint=false];
  "pIYOk" -> "Yard";
  "pIYScrap" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pIYScrap", fontsize=8];
  "Inspection" -> "pIYScrap" [constraint=false];
  "pIYScrap" -> "Yard";
  "pIYRoom" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pIYRoom", fontsize=8];
  "Inspection" -> "pIYRoom" [constraint=false];
  "pIYRoom" -> "Yard";
  "pIRMach" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pIRMach", fontsize=8];
  "Inspection" -> "pIRMach";
  "pIRMach" -> "Repair";
  "pIRHb" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pIRHb", fontsize=8];
  "Inspection" -> "pIRHb";
  "pIRHb" -> "Repair";
  "pRI" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pRI", fontsize=8];
  "Repair" -> "pRI";
  "pRI" -> "Inspection";
  "pRYReady" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pRYReady", fontsize=8];
  "Repair" -> "pRYReady" [constraint=false];
  "pRYReady" -> "Yard";
  "pDYOrder" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pDYOrder", fontsize=8];
  "Departure" -> "pDYOrder" [constraint=false];
  "pDYOrder" -> "Yard";
  "pYDOut" [shape=circle, fixedsize=true, width=0.22, label="", xlabel="pYDOut", fontsize=8];
  "Yard" -> "pYDOut";
  "pYDOut" -> "Departure";
}
