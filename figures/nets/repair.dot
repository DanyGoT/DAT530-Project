// Repair module, made by analysis/net_dot.m from repair_pdf.m.
digraph Repair {
  rankdir=LR; nodesep=0.3; ranksep=0.8; forcelabels=true;
  label="Repair"; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10, label=""];
  edge [arrowsize=0.6, penwidth=0.8];
  "tRHbHall" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRHbHall"];
  "tRHbReady" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRHbReady"];
  "tRInHb" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRInHb"];
  "tRInMach" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRInMach"];
  "tRMachHall" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRMachHall"];
  "tRMachReady" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tRMachReady"];
  { rank=min; "tRInMach"; "tRInHb";  }
  { rank=max; "tRMachHall"; "tRMachReady"; "tRHbHall"; "tRHbReady";  }
  "pRMach" [shape=circle, fixedsize=true, width=0.36, xlabel="pRMach", label="2197"];
  "pRHb" [shape=circle, fixedsize=true, width=0.36, xlabel="pRHb", label="1443"];
  "tRInMach" -> "pRMach";
  "tRInHb" -> "pRHb";
  "pRMach" -> "tRMachHall";
  "pRMach" -> "tRMachReady";
  "pRHb" -> "tRHbHall";
  "pRHb" -> "tRHbReady";
}
