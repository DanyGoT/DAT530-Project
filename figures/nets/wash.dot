// Washing module, made by analysis/net_dot.m from wash_pdf.m.
digraph Washing {
  rankdir=LR; nodesep=0.3; ranksep=0.8; forcelabels=true;
  label="Washing"; labelloc=t; fontname="Helvetica"; fontsize=14;
  node [fontname="Helvetica", fontsize=10, label=""];
  edge [arrowsize=0.6, penwidth=0.8];
  "tWIn" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tWIn"];
  "tWOut" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#1f5fa8", fillcolor="#1f5fa8", xlabel="tWOut"];
  "tWash_1" [shape=box, style=filled, fixedsize=true, width=0.08, height=0.42, color="#222222", fillcolor="#222222", xlabel="tWash_1...2"];
  { rank=min; "tWIn";  }
  { rank=max; "tWOut";  }
  "pWRack" [shape=circle, fixedsize=true, width=0.36, xlabel="pWRack", label=""];
  "pWDone" [shape=circle, fixedsize=true, width=0.36, xlabel="pWDone", label=""];
  "tWIn" -> "pWRack";
  "pWDone" -> "tWOut";
  "pWRack" -> "tWash_1";
  "tWash_1" -> "pWDone";
}
